KODI_VERSION=21.3

# Per Ubuntu release, suffixed with the version without the dot:
#   DEBIAN_REVISION_<NODOT>     Debian source revision we rebuild
#                               (1 -> kodi_21.3+dfsg-1.dsc).
#   SNAPSHOT_TIMESTAMP_<NODOT>  a snapshot.debian.org time when that revision
#                               was in the archive; fetch-source.sh falls back
#                               to it once Debian drops it from the live pool.
#   UBUNTU_BUILD_<NODOT>        rebuild counter for re-releases of the SAME
#                               Kodi/Debian version (e.g. after adding a patch
#                               to patches/backports/). Bump it to publish a
#                               package apt treats as an upgrade; it is the
#                               trailing digit of ~ubuntu<NODOT><BUILD>
#                               (24.04 build 4 -> ~ubuntu24044). Reset to 1
#                               when KODI_VERSION changes.

# 24.04 (noble). Tags .1-.3 predate the build counter and all shipped as
# ~ubuntu24041; build 4 is the first with the PipeWire backport.
DEBIAN_REVISION_2404=1
SNAPSHOT_TIMESTAMP_2404=20260201T000000Z
UBUNTU_BUILD_2404=4

# 26.04 (resolute). Debian's -1.1 NMU carries the ffmpeg 8 build fixes, and
# 1.1~ubuntu2604<BUILD> sorts above Ubuntu's stock 2:21.3+dfsg-1ubuntu1.
DEBIAN_REVISION_2604=1.1
SNAPSHOT_TIMESTAMP_2604=20260601T000000Z
UBUNTU_BUILD_2604=1
